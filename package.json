{
  "name": "aipal",
  "productName": "AIPal",
  "version": "0.1.8",
  "description": "AI 语音游戏搭子：实时通话 + 看得懂画面 + 记得住你",
  "main": "main.js",
  "author": {
    "name": "AIPal",
    "email": "aipal@example.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev"
  },
  "dependencies": {
    "msedge-tts": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aipal.app",
    "productName": "AIPal",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "renderer/**/*",
      "helpers/**/*",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "AIPal-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AIPal",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "AIPal-${version}-portable.${ext}"
    },
    "asar": false
  }
}